# Optional. A Groq API key enables a second generation backend, used if you set
# KIVI_CHAT_PROVIDER=groq and as an automatic fallback when a request fails. It answers
# faster, but its free-tier model returns malformed tool calls often enough that Gemini
# is the default. The system runs entirely on Gemini without this.
GROQ_API_KEY=
# Optional extra Groq keys, comma separated, rotated on rate limits.
GROQ_API_KEYS=
KIVI_GROQ_MODEL=openai/gpt-oss-120b

# Which backend generates: auto (Groq when a key is set, else Gemini), gemini, or groq.
KIVI_LLM_PROVIDER=gemini

# Required for retrieval embeddings even when Groq is generating — Groq has no embedding
# endpoint. Also the fallback generation backend.
GEMINI_API_KEY=

# Optional. Extra keys, comma separated. If the key above hits its daily free-tier
# quota mid-run, the client moves to the next key instead of stalling. Not needed
# on a paid key.
GEMINI_API_KEYS=

# Optional overrides.
KIVI_DB_PATH=./db/kivi.db
# gemini-3.5-flash gives better answers; flash-lite is the default because it has a far
# more generous free-tier quota. Set these to gemini-3.5-flash if your key is paid.
KIVI_CHAT_MODEL=gemini-3.5-flash-lite
KIVI_EXTRACT_MODEL=gemini-3.5-flash-lite
KIVI_EXTRACT_BATCH=5
# auto = use the embedding API, fall back to the built-in local embedder if it is
# unavailable or out of quota. gemini = API only. local = never call the API.
KIVI_EMBED_PROVIDER=auto
KIVI_EMBED_MODEL=gemini-embedding-2
KIVI_EMBED_DIM=768
KIVI_USER_ID=u_demo
KIVI_MIN_MEMORY_SCORE=0.30
KIVI_INGEST_CONCURRENCY=6

# Pause between evaluation cases, in milliseconds. Free tiers meter tokens per minute;
# 20000 lets a 30-case run finish without spending most of its time in retry back-off.
KIVI_EVAL_PACE_MS=0
